{
  "name": "video-read-along",
  "version": "1.0.0",
  "description": "视频跟读软件 - 支持倍速播放和字幕开关",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "server": "node server/english-subtitle-server.mjs",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build:vite": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "electron",
    "vue",
    "video",
    "learning"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue": "^3.4.15",
    "vue-tsc": "^2.0.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "multer": "^2.1.1",
    "video.js": "^8.10.0"
  },
  "build": {
    "appId": "com.video-read-along.app",
    "productName": "video-read-along",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "whisper.cpp",
        "to": "whisper.cpp",
        "filter": [
          "whisper-cli.exe",
          "*.dll"
        ]
      },
      {
        "from": "whisper.cpp/models",
        "to": "whisper.cpp/models",
        "filter": [
          "ggml-small.en.bin"
        ]
      },
      {
        "from": "ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "node-portable",
        "to": "node-portable"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "video-read-along",
      "artifactName": "${productName}-windows-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
